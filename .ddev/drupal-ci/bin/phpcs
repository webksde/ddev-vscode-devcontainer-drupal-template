#!/bin/bash
#
# PHP_CodeSniffer, like the "phpcs" job of the drupal.org GitLab CI templates.
#
# Usage: phpcs [--option=value ...] [path ...] [-- tool args]
#
# Uses the project's own (.)phpcs.xml(.dist), otherwise the gitlab_templates
# default (Drupal standard, without DrupalPractice).

# shellcheck source-path=SCRIPTDIR source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

run() {
  local project="$1"
  shift
  local -a opts=(-s --report-width=120 --basepath="$project")
  ci_is_tty && opts+=(--colors)
  "$COMPOSER_BIN/phpcs" --standard="$(ci_phpcs_standard "$project")" "${opts[@]}" "${CI_OPTS[@]}" "$@"
}

ci_parse_args "$@"
ci_require_ci_files
ci_for_each_project run
