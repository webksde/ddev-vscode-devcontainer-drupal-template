#!/bin/bash
#
# Stylelint, like the "stylelint" job of the drupal.org GitLab CI templates.
#
# Usage: stylelint [--fix] [--option=value ...] [path ...] [-- tool args]
#
# Uses core's node modules, the project's own stylelint config or else core's
# .stylelintrc.json, and core's .prettierrc.json unless the project has its own.

# shellcheck source-path=SCRIPTDIR source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

run() {
  local project="$1"
  shift
  ci_link_parent_configs "$(dirname "$project")"
  local -a opts=(--ignore-path=./.stylelintignore --allow-empty-input)
  ci_is_tty && opts+=(--color)
  if ! compgen -G ".stylelintrc*" >/dev/null && ! compgen -G "stylelint.config.*" >/dev/null; then
    opts+=(--config="$CORE_DIR/.stylelintrc.json")
  fi
  # CI passes ./**/*.css unquoted, so bash (without globstar) expands it to the
  # CSS files exactly one folder deep, e.g. css/*.css. Only if nothing matches,
  # stylelint gets the pattern itself and checks all CSS files recursively.
  shopt -u globstar nullglob
  local target
  local -a targets=()
  for target in "$@"; do
    if [[ -d $target ]]; then
      if [[ $target == "." ]]; then
        targets+=(./**/*.css)
      else
        targets+=("./$target"/**/*.css)
      fi
    else
      targets+=("$target")
    fi
  done
  "$NODE_BIN/stylelint" "${opts[@]}" "${CI_OPTS[@]}" "${targets[@]}"
}

ci_parse_args "$@"
ci_require_node_modules
ci_for_each_project run
