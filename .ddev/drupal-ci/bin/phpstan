#!/bin/bash
#
# PHPStan, like the "phpstan" job of the drupal.org GitLab CI templates.
#
# Usage: phpstan [--option=value ...] [path ...] [-- tool args]
#
# Runs from the project root. Uses the project's own phpstan.neon,
# phpstan.neon.dist or phpstan.dist.neon, otherwise the gitlab_templates
# default (level 0, plus the project's phpstan-baseline.neon if it has one).

# shellcheck source-path=SCRIPTDIR source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

run() {
  local project="$1"
  shift
  local -a opts=(--autoload-file="$APP_ROOT/vendor/autoload.php")
  ci_is_tty || opts+=(--no-progress)
  if [[ ! -f phpstan.neon && ! -f phpstan.neon.dist && ! -f phpstan.dist.neon ]]; then
    # The default config includes the baseline file. CI creates an empty one;
    # here the include is dropped instead, so nothing is written to the project.
    local config
    config="$(mktemp --suffix=.neon)"
    trap 'rm -f "$config"' EXIT
    if [[ -f phpstan-baseline.neon ]]; then
      sed "s#BASELINE_PLACEHOLDER#$project/phpstan-baseline.neon#" "$DRUPAL_CI_DIR/assets/phpstan.neon" >"$config"
    else
      sed -e '/BASELINE_PLACEHOLDER/d' -e '/^includes:/d' "$DRUPAL_CI_DIR/assets/phpstan.neon" >"$config"
    fi
    opts+=(--configuration="$config")
  fi
  php "$COMPOSER_BIN/phpstan" analyze "${opts[@]}" "${CI_OPTS[@]}" "$@"
}

ci_parse_args "$@"
ci_for_each_project run
