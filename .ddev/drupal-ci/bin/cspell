#!/bin/bash
#
# CSpell, like the "cspell" job of the drupal.org GitLab CI templates.
#
# Usage: cspell [--option=value ...] [path ...] [-- tool args]
#   e.g. "cspell --words-only --unique web/modules/custom/foo" lists the
#   unknown words only.
#
# Uses the project's own .cspell.json, otherwise the gitlab_templates default,
# expanded by gitlab_templates' prepare-cspell.php like in CI: core's
# dictionaries, the project's .cspell-project-words.txt, the project's machine
# names as words, the default flag words and ignore paths. The expanded config
# is written to a temporary file, not into the project.

# shellcheck source-path=SCRIPTDIR source=../lib/common.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

run() {
  local project="$1"
  shift
  local config
  config="$(mktemp --suffix=.json)"
  trap 'rm -f "$config"' EXIT
  php "$DRUPAL_CI_DIR/lib/cspell.php" project "$project" "$config" || return 2
  local -a opts=(--config="$config" --show-suggestions --show-context --no-progress --no-summary)
  ci_is_tty && opts+=(--color)
  "$NODE_BIN/cspell" "${opts[@]}" "${CI_OPTS[@]}" "$@"
}

ci_parse_args "$@"
ci_require_ci_files
ci_require_node_modules
ci_for_each_project run
