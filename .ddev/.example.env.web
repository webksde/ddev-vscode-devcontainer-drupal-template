# Personal environment variables for the ddev web container.
# Lists all available variables. The "drowl-init*" commands create
# ".ddev/.env.web" (gitignored!) with your git identity and DRUPALCODE_TOKEN.
# Add or change any of the variables below there, then run "ddev restart"
# (and "ddev code" again, if VSCode is attached).

# Git identity for commits made inside the container (VSCode Source Control,
# terminal, Claude Code). Without this, commits are authored by "DDEV User".
GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="you@example.com"
GIT_COMMITTER_NAME="Your Name"
GIT_COMMITTER_EMAIL="you@example.com"

# FINE-GRAINED personal access token for git.drupalcode.org (legacy tokens are rejected).
# Used by the drupalcode GitLab MCP server for Claude Code (see .mcp.json).
# Step-by-step guide: README.md, "Personal settings".
DRUPALCODE_TOKEN="glpat-..."
