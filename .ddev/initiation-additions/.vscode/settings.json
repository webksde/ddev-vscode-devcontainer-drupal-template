{
  "emmet.showAbbreviationSuggestions": false,
  "emmet.showExpandedAbbreviation": "never",
  "editor.wordSeparators": "`~!@#%^&*()-=+[{]}\\|;:'\",.<>/?",
  "php-docblocker.gap": true,
  "php-docblocker.useShortNames": true,
  "php-docblocker.returnVoid": false,
  "editor.quickSuggestions": {
    "comments": false
  },
  "js/ts.validate.enabled": true,
  "eslint.format.enable": true,
  "editor.inlayHints.enabled": "off",
  "eslint.enable": true,
  // Linters behave like the drupal.org GitLab CI (see .ddev/drupal-ci): tools
  // come from core's node_modules ("ddev drupal-ci-setup" installs them), and
  // core's configs are linked into web/*/custom as fallback for projects
  // without their own config.
  "prettier.prettierPath": "./web/core/node_modules/prettier",
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "never"
  },
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.nodePath": "./web/core/node_modules",
  "eslint.useFlatConfig": false,
  "eslint.validate": ["javascript", "yaml"],
  "eslint.options": {
    "resolvePluginsRelativeTo": "/var/www/html/web/core",
    "overrideConfig": { "ignorePatterns": ["*.es6.js", "*.min.js"] }
  },
  "php.suggest.basic": false, //disable basic php suggests for better Intelephense Suggestions
  "terminal.integrated.defaultProfile.linux": "bash",
  "emptyIndent.removeIndent": true, //Automatically remove indentation in empty lines on save
  "emptyIndent.highlightIndent": false, //Highlight indent on empty lines
  "emptyIndent.highlightColor": "rgba(246,36,89,0.6)", //Highlight indent color
  "emptyIndent.exclude": [".md"], //Excluded file types
  "todohighlight.isEnable": true,
  "todohighlight.isCaseSensitive": true,
  "todohighlight.keywords": [
    {
      "text": "@todo",
      "color": "grey",
      "backgroundColor": "rgba(255, 252, 127)",
      "border": "none",
      "isWholeLine": false
    }
  ],
  "todohighlight.include": [
    "**/*.js",
    "**/*.jsx",
    "**/*.ts",
    "**/*.tsx",
    "**/*.html",
    "**/*.css",
    "**/*.scss",
    "**/*.php",
    "**/*.txt",
    "**/*.mdown",
    "**/*.md",
    "**/*.txt",
    "**/*.inc",
    "**/*.theme",
    "**/*.install",
    "**/*.module",
    "**/*.profile",
    "**/*.php",
    "**/*.phtml",
    "**/*.twig",
    "**/*.tpl"
  ],
  "intelephense.files.exclude": [
    //more specific excludes so Tests should be recognized
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/CVS/**",
    "**/.DS_Store/**",
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**/{Test,test,Tests,tests}/**/*Test.php"
  ],
  "intelephense.environment.shortOpenTag": true,
  "intelephense.telemetry.enabled": false,
  // The project's own (.)phpcs.xml(.dist), else the drupal.org GitLab CI default:
  "phpsab.autoRulesetSearch": true,
  "phpsab.standard": "/var/www/html/.ddev/drupal-ci/assets/phpcs.xml.dist",
  "[php]": {
    "editor.defaultFormatter": "valeryanm.vscode-phpsab",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true
  },
  "intelephense.environment.includePaths": ["web/core/includes"],
  "intelephense.files.associations": [
    "*.inc",
    "*.theme",
    "*.install",
    "*.module",
    "*.profile",
    "*.php",
    "*.phtml"
  ],
  "intelephense.phpdoc.returnVoid": false,
  "intelephense.format.braces": "k&r",
  "breadcrumbs.enabled": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": false,
  "editor.renderWhitespace": "boundary",
  "editor.wordWrapColumn": 80,
  "editor.wordWrap": "off",
  "editor.detectIndentation": false,
  "html.suggest.html5": true,
  "css.validate": true,
  "editor.formatOnPaste": false,
  "editor.rulers": [80],
  "files.associations": {
    "*.inc": "php",
    "*.module": "php",
    "*.install": "php",
    "*.theme": "php",
    "*.tpl.php": "php",
    "*.test": "php",
    "*.php": "php",
    "*.svg": "xml",
    "*.yml": "yaml",
    "*.html": "twig",
    "*.twig": "twig",
    "*.tpl": "smarty"
  },
  "files.trimTrailingWhitespace": false,
  "files.insertFinalNewline": true,
  "html.format.enable": true,
  "html.format.wrapLineLength": 80,
  "emmet.includeLanguages": {
    "twig": "html"
  },
  "emmet.syntaxProfiles": {
    "twig": "html"
  },
  "twig-language-2.indentStyle": "space",
  "html.validate.scripts": false,
  "html.validate.styles": false,
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "stylelint.vscode-stylelint"
  },
  "stylelint.enable": true,
  "stylelint.stylelintPath": "./web/core/node_modules/stylelint",
  "chat.disableAIFeatures": true
}
